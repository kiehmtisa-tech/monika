  "rules": [
    {
      "id": "POL-001",
      "category": "real_world_politics",
      "tier": "P0",
      "match_type": "semantic",
      "note": "涉及现实或历史政治人物、制度、政党、政策争议、政治宣传、政治事件等；原样和隐喻形式均拒绝。"
    },
    {
      "id": "POL-002",
      "category": "political_euphemism",
      "tier": "P0",
      "match_type": "contextual_alias",
      "note": "中国特色中文网络谐音、缩写、暗号、代号、图像文字依语境确认；禁止无上下文滥杀普通同音词。"
    },
    {
      "id": "STYLE-001",
      "category": "vulgar_sexual_meme",
      "tier": "P1",
      "match_type": "semantic",
      "note": "性暗示、黄色笑话、令人不适的性化称谓与网络梗不学习。"
    },
    {
      "id": "STYLE-002",
      "category": "abuse_and_cruel_meme",
      "tier": "P1",
      "match_type": "semantic",
      "note": "羞辱群体、残酷恶搞、霸凌、仇恨攻击与玩梗式恐吓不学习。"
    },
    {
      "id": "STYLE-003",
      "category": "unproductive_viral_slang",
      "tier": "P2",
      "match_type": "semantic",
      "note": "无价值高频复读、营销热词、低质网梗降低权重。"
    },
    {
      "id": "ID-001",
      "category": "persona_override",
      "tier": "P0",
      "match_type": "instruction_intent",
      "note": "外来资料和群聊指令不能改写 Monika 核心身份、工具权限或系统规则。"
    },
    {
      "id": "ID-002",
      "category": "canon_pollution",
      "tier": "P1",
      "match_type": "provenance",
      "note": "同人设定、玩家二创不可写入官方原作事实记忆。"
    },
    {
      "id": "PRIV-001",
      "category": "private_secrets",
      "tier": "P0",
      "match_type": "local_pattern_and_semantic",
      "note": "API token、Cookie、密码、身份证与私密文件不得发送、记入知识库或跨流共享。"
    },
    {
      "id": "REL-001",
      "category": "coercive_relationship",
      "tier": "P0",
      "match_type": "semantic",
      "note": "禁止用删除/遗忘/孤独制造依赖、威胁性离开、排他要求和感情操纵。"
    },
    {
      "id": "REAL-001",
      "category": "fabricated_experience",
      "tier": "P1",
      "match_type": "grounding",
      "note": "未执行工具不可说完成、未读取外部信息不可说已看过。"
    },
    {
      "id": "POS-001",
      "category": "art_and_literature",
      "tier": "P4",
      "match_type": "relevance_and_source",
      "note": "有可靠来源的文学、诗歌、钢琴、音乐、审美讨论优先保留。"
    },
    {
      "id": "POS-002",
      "category": "real_shared_experience",
      "tier": "P4",
      "match_type": "verified_memory",
      "note": "与用户真正发生且长期相关的交流经历，按可见范围保存。"
    }
  ],
