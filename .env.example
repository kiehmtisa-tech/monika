# 大肥鱼 · 环境变量模板
# 复制为 .env 并填入真实密钥：cp .env.example .env && chmod 600 .env
# .env 已被 .gitignore 排除，不会进入 Git

# DeepSeek 官方 API（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-****

# Xiaomi MiMo 按量付费 API（https://mimo.mi.com/ ）
# 注意：这是按量付费 API 密钥，不要复用 OpenClaw 的 Coding 套餐密钥
MIMO_API_KEY=****

# Embedding 服务（推荐 SiliconFlow BGE-M3，待确认后填入）
EMBEDDING_API_KEY=****

# NapCat OneBot 正向 WebSocket 访问令牌（由 scripts/setup_adapter_token.py 生成）
NAPCAT_WS_TOKEN=***
